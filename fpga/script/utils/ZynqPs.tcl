# Zynq UltraScale+ processing system (the ARM cores, DDR, ...) with the ZCU216 board preset.
# Only one PL-facing AXI master is kept, HPM0_LPD, the port the processor uses to reach our
# registers. Its clock is pl_clk0, a 100 MHz clock generated by the PS for the PL.
create_bd_cell -type ip -vlnv xilinx.com:ip:zynq_ultra_ps_e:3.5 zynq_ps
apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e -config {apply_board_preset "1"} [get_bd_cells zynq_ps]
set_property -dict [list CONFIG.PSU__USE__M_AXI_GP0 {0} CONFIG.PSU__USE__M_AXI_GP1 {0} CONFIG.PSU__USE__M_AXI_GP2 {1}] [get_bd_cells zynq_ps]
connect_bd_net [get_bd_pins zynq_ps/pl_clk0] [get_bd_pins zynq_ps/maxihpm0_lpd_aclk]

# Reset synchroniser: pl_resetn0 (active low) -> clean active-high reset in the pl_clk0 domain
create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 ps_rst
connect_bd_net [get_bd_pins zynq_ps/pl_clk0] [get_bd_pins ps_rst/slowest_sync_clk]
connect_bd_net [get_bd_pins zynq_ps/pl_resetn0] [get_bd_pins ps_rst/ext_reset_in]
